<Window x:Class="TimeBomb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeBomb"
        Width="180" Height="82"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Glow Effect for Normal State -->
        <DropShadowEffect x:Key="NormalGlow" Color="#23FF23" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="RedGlow" Color="#FF2323" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
    </Window.Resources>

    <Border x:Name="RootBorder" 
            Background="#E61E1E24" 
            BorderBrush="#4423FF23" 
            BorderThickness="1" 
            CornerRadius="8" 
            SnapsToDevicePixels="True"
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="6,4,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Instance Badge -->
            <Border x:Name="BadgeBorder"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="2,2,0,0"
                    Background="#2A23FF23"
                    CornerRadius="3"
                    Padding="3,1,3,1"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtBadge"
                           Text="#1"
                           FontFamily="Segoe UI, Arial"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="#80FFA0"/>
            </Border>

            <!-- Main Time Display -->
            <TextBlock x:Name="TxtMainTime" 
                       Grid.Row="0"
                       Text="00:00"
                       FontFamily="pack://application:,,,/Resources/Fonts/#DS-Digital, Consolas, Courier New"
                       FontSize="38"
                       FontWeight="Bold"
                       Foreground="#23FF23"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Effect="{StaticResource NormalGlow}"
                       SnapsToDevicePixels="True"/>

            <!-- Bottom Sub Info Row -->
            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,-2,0,0">
                <TextBlock x:Name="TxtPrefix" 
                           Text="Ends at: " 
                           FontFamily="Segoe UI, Arial" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="#A0FFA0"
                           Margin="0,0,3,0"/>
                <TextBlock x:Name="TxtSubTime" 
                           Text="--:--:--" 
                           FontFamily="Segoe UI, Arial" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="#A0FFA0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
