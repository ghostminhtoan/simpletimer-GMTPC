<Window x:Class="TimeBomb.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Width="380" Height="70"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <DropShadowEffect x:Key="ToastGlow" Color="#23FF23" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="TextGlow" Color="#23FF23" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#E618181E"
            BorderBrush="#23FF23"
            BorderThickness="1.5"
            CornerRadius="8"
            Effect="{StaticResource ToastGlow}"
            SnapsToDevicePixels="True">
        <Grid Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Border Grid.Column="0"
                    Width="38" Height="38"
                    Background="#2623FF23"
                    BorderBrush="#4423FF23"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <TextBlock Text="🖥"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Text Content (No dismiss button) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="VIRTUAL DESKTOP"
                           FontFamily="Segoe UI, Arial"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#A0FFA0"
                           Effect="{StaticResource TextGlow}"
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="TxtMessage"
                           Text="Bấm Windows + Tab để chuyển desktop nếu cần"
                           FontFamily="Segoe UI, Arial"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
