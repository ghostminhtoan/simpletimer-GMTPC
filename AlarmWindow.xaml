<Window x:Class="TimeBomb.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeBomb Alarm"
        Width="360" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Modern Cyberpunk Button Style -->
        <Style x:Key="ModernAlarmBtn" TargetType="Button">
            <Setter Property="Background" Value="#35353C"/>
            <Setter Property="Foreground" Value="#23FF23"/>
            <Setter Property="BorderBrush" Value="#23FF23"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4C4C56"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#66FF66"/>
                                <Setter Property="Foreground" Value="#66FF66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#23FF23"/>
                                <Setter Property="Foreground" Value="#1E1E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F223232A" 
            BorderBrush="#23FF23" 
            BorderThickness="2" 
            CornerRadius="10"
            Cursor="SizeAll"
            MouseLeftButtonDown="OnBorderMouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#23FF23" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Alarm Message -->
            <TextBlock Grid.Row="0" 
                       Text="Beep, Beep turn it off."
                       FontFamily="pack://application:,,,/Resources/Fonts/#DS-Digital, Segoe UI, Arial"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#A0FFA0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#23FF23" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Bottom">
                <Button x:Name="BtnDone" 
                        Content="Done" 
                        Width="110" Height="36" 
                        Style="{StaticResource ModernAlarmBtn}"
                        Margin="0,0,15,0"
                        Click="BtnDone_Click"/>
                <Button x:Name="BtnReset" 
                        Content="Reset" 
                        Width="110" Height="36" 
                        Style="{StaticResource ModernAlarmBtn}"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
