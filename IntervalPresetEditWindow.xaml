<Window x:Class="TimeBomb.IntervalPresetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Preset" 
        Height="360" Width="300"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.7"/>
        <DropShadowEffect x:Key="NormalGlow" Color="#23FF23" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#3323FF23"/>
            <Setter Property="Foreground" Value="#23FF23"/>
            <Setter Property="BorderBrush" Value="#23FF23"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5523FF23"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7723FF23"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberOrangeButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#33FF9900"/>
            <Setter Property="Foreground" Value="#FF9900"/>
            <Setter Property="BorderBrush" Value="#FF9900"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55FF9900"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#77FF9900"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyberGrayButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#88AA88"/>
            <Setter Property="BorderBrush" Value="#4423FF23"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#353540"/>
                    <Setter Property="Foreground" Value="#23FF23"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyberInput" TargetType="TextBox">
            <Setter Property="Background" Value="#221E1E24"/>
            <Setter Property="Foreground" Value="#23FF23"/>
            <Setter Property="BorderBrush" Value="#4423FF23"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="CaretBrush" Value="#23FF23"/>
        </Style>

        <Style x:Key="CyberCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#23FF23"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBox"
                                    Width="14" Height="14"
                                    Background="#262630"
                                    BorderBrush="#4423FF23"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,3,0">
                                <TextBlock x:Name="chkMark" Text="✓"
                                           Foreground="#23FF23"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#23FF23"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#66FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Border Background="#F21E1E24" 
                BorderBrush="#23FF23" 
                BorderThickness="1.5" 
                CornerRadius="10" 
                Effect="{StaticResource WindowShadow}">
            <Grid Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Name Input -->
                    <RowDefinition Height="Auto"/>
                    <!-- Timing Inputs Grid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Loops -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="EDIT PRESET" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#23FF23" 
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnClose" 
                            Content="✕" 
                            DockPanel.Dock="Right" 
                            Width="22" Height="22" 
                            Background="Transparent" 
                            Foreground="#88AA88" 
                            BorderThickness="0" 
                            FontSize="12" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Click="BtnCancel_Click"/>
                </DockPanel>

                <!-- Preset Name -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Preset Name (Tên hiển thị)" FontSize="10" Foreground="#A0FFA0" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtName" MaxLength="16" Style="{StaticResource CyberInput}"
                             HorizontalContentAlignment="Left" Padding="6,3" KeyDown="Input_KeyDown"/>
                </StackPanel>

                <!-- Timing Inputs (2x2 Grid) -->
                <Border Grid.Row="2" 
                        Background="#251E1E28" 
                        BorderBrush="#35353A" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="8,6" 
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Work & Rest -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,2">
                            <TextBlock Text="Work (sec)" FontSize="10" Foreground="#23FF23" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtWork" Style="{StaticResource CyberInput}" KeyDown="Input_KeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,2">
                            <TextBlock Text="Rest (sec)" FontSize="10" Foreground="#FF9900" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtRest" Style="{StaticResource CyberInput}" KeyDown="Input_KeyDown"/>
                        </StackPanel>

                        <!-- Row 1: Prepare & End -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,4,4,2">
                            <TextBlock Text="Prepare (sec)" FontSize="10" Foreground="#A0FFA0" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtPrepare" Style="{StaticResource CyberInput}" KeyDown="Input_KeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,4,4,2">
                            <TextBlock Text="End (sec)" FontSize="10" Foreground="#A0FFA0" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtEnd" Style="{StaticResource CyberInput}" KeyDown="Input_KeyDown"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Loops and Infinite -->
                <Grid Grid.Row="3" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Loops (Số vòng lặp)" FontSize="10" Foreground="#A0FFA0" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtLoops" Style="{StaticResource CyberInput}" KeyDown="Input_KeyDown"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkInfinite" Grid.Column="1" Content="∞ Vô tận" 
                              Style="{StaticResource CyberCheckBox}" 
                              VerticalAlignment="Bottom" Margin="0,0,0,5"
                              Checked="ChkInfinite_Checked" Unchecked="ChkInfinite_Unchecked"/>
                </Grid>

                <!-- Action Buttons -->
                <UniformGrid Grid.Row="4" Rows="1" Columns="3">
                    <Button x:Name="BtnSave" Content="LƯU" Style="{StaticResource CyberButton}" Margin="2,0" Click="BtnSave_Click"/>
                    <Button x:Name="BtnReset" Content="MẶC ĐỊNH" Style="{StaticResource CyberOrangeButton}" Margin="2,0" Click="BtnReset_Click"/>
                    <Button x:Name="BtnCancel" Content="HỦY" Style="{StaticResource CyberGrayButton}" Margin="2,0" Click="BtnCancel_Click"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
